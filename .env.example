# Frontend (Vite) — prefixed with VITE_ to be available in the browser
VITE_GOOGLE_SHEET_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
VITE_WHATSAPP_NUMBER=5511999999999

# Facebook Conversions API (server-side only — Vercel env vars)
PIXEL_ID=your_pixel_id
CAPI_ACCESS_TOKEN=your_capi_access_token

# LK Chatbot webhook (WhatsApp report delivery)
LK_CHATBOT_URL=https://your-chatbot-domain.com
LK_CHATBOT_API_KEY=your_chatbot_api_key
LK_CHATBOT_TENANT_ID=your_tenant_id
